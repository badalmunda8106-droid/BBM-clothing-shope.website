*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif}button,input,select{font:inherit}button,a{cursor:pointer}a{color:inherit;text-decoration:none}.announcement{background:var(--ink);color:white;text-align:center;padding:10px;font-size:10px;letter-spacing:.18em;text-transform:uppercase}.nav{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;border-bottom:1px solid var(--line);gap:20px}.logo{font-weight:950;font-size:31px;letter-spacing:-.09em}.logo span{font-size:10px;letter-spacing:.18em;display:block;margin-top:-3px}.navlinks{display:flex;gap:25px;font-size:11px;text-transform:uppercase;letter-spacing:.12em}.navright{display:flex;align-items:center;gap:16px;font-size:12px}.plain{border:0;background:none;padding:8px}.menu{display:none}.hero{margin:22px auto 0;width:calc(100% - 44px);min-height:500px;background:#b5a58f;position:relative;overflow:hidden;display:flex;align-items:end;color:#fff}.hero-photo{position:absolute;inset:0;background:linear-gradient(90deg,rgba(15,15,13,.66),rgba(15,15,13,.05)),url('https://images.unsplash.com/photo-1523398002811-999ca8dec234?auto=format&fit=crop&w=1800&q=85') center 42%/cover}.hero-copy{position:relative;padding:clamp(28px,6vw,78px);max-width:700px}.eyebrow{font-size:10px;letter-spacing:.22em;text-transform:uppercase}.hero h1{font-size:clamp(48px,8vw,100px);line-height:.88;letter-spacing:-.07em;margin:20px 0}.hero p{max-width:360px;line-height:1.6;font-size:14px;color:#f2eee7}.btn{border:1px solid var(--ink);background:var(--ink);color:#fff;padding:14px 20px;font-size:10px;letter-spacing:.15em;text-transform:uppercase;display:inline-flex;align-items:center;justify-content:center;gap:10px}.btn.light{background:var(--paper);border-color:var(--paper);color:var(--ink)}.section{padding:75px 5vw}.sectionhead{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:25px}.section h2{font-size:clamp(30px,4vw,50px);letter-spacing:-.06em;margin:8px 0}.muted{color:var(--muted)}.categories{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.category{position:relative;min-height:220px;background:var(--cream);overflow:hidden;display:flex;align-items:end;padding:18px;color:#fff}.category:before{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.65),transparent 65%),var(--bg) center/cover;transition:transform .4s}.category:hover:before{transform:scale(1.04)}.category strong{position:relative;font-size:17px;letter-spacing:-.03em}.category small{display:block;font-size:9px;letter-spacing:.14em;text-transform:uppercase;margin-top:6px}.toolbar{display:flex;gap:10px;flex-wrap:wrap}.toolbar input,.toolbar select{background:transparent;border:1px solid var(--line);padding:12px;color:var(--ink);min-width:140px}.products{display:grid;grid-template-columns:repeat(4,1fr);gap:22px 12px}.product{min-width:0}.product-img{aspect-ratio:3/4;background:#e8e2d7;position:relative;overflow:hidden}.product-img img{width:100%;height:100%;object-fit:cover;display:block;mix-blend-mode:multiply;transition:transform .35s}.product:hover img{transform:scale(1.04)}.sample{position:absolute;top:10px;left:10px;background:var(--paper);padding:6px 8px;font-size:9px;letter-spacing:.1em;text-transform:uppercase}.quick{position:absolute;bottom:10px;left:10px;right:10px;width:calc(100% - 20px);opacity:0;transition:opacity .2s}.product:hover .quick{opacity:1}.product-meta{display:flex;justify-content:space-between;gap:10px;margin-top:12px;font-size:12px}.product-name{font-weight:700}.product-sub{font-size:10px;color:var(--muted);margin-top:6px}.price{white-space:nowrap}.note{font-size:11px;color:var(--muted);line-height:1.6}.editorial{background:var(--cream);display:grid;grid-template-columns:1fr 1fr;min-height:350px}.editorial-image{background:url('https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=1000&q=85') center/cover;min-height:300px}.editorial-copy{padding:clamp(28px,6vw,70px);display:flex;flex-direction:column;justify-content:center}.editorial-copy h2{font-size:clamp(35px,5vw,64px);line-height:.95;letter-spacing:-.07em;margin:15px 0}.newsletter{background:#d7c8b5;text-align:center;padding:65px 20px}.newsletter h2{font-size:clamp(30px,4vw,48px);letter-spacing:-.06em;margin:12px}.signup{display:flex;max-width:460px;margin:24px auto 10px}.signup input{flex:1;min-width:0;padding:14px;border:1px solid var(--ink);background:transparent}.signup button{border:1px solid var(--ink);background:var(--ink);color:white;padding:0 18px;font-size:10px;letter-spacing:.1em}.footer{background:var(--ink);color:white;padding:50px 5vw 25px}.footergrid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:30px}.footer p,.footer a{font-size:12px;color:#c4c0b7;line-height:1.9}.footer h4{font-size:10px;letter-spacing:.15em;text-transform:uppercase}.footbottom{border-top:1px solid #45443f;margin-top:35px;padding-top:18px;font-size:10px;color:#aaa69e;display:flex;justify-content:space-between;gap:10px}.modal{display:none;position:fixed;inset:0;background:#0009;z-index:10;align-items:center;justify-content:center;padding:16px}.modal.open{display:flex}.modalbox{background:var(--paper);max-width:780px;width:100%;max-height:90vh;overflow:auto;display:grid;grid-template-columns:1fr 1fr;position:relative}.modalbox img{width:100%;height:100%;min-height:400px;object-fit:cover}.modalinfo{padding:30px}.close{position:absolute;right:12px;top:12px;background:var(--paper);border:1px solid var(--line);width:36px;height:36px}.option{margin:18px 0}.option label{font-size:10px;letter-spacing:.1em;text-transform:uppercase;display:block;margin-bottom:8px}.option select{width:100%;padding:12px;background:transparent;border:1px solid var(--line)}.cartpanel{position:fixed;right:0;top:0;bottom:0;width:min(420px,100%);background:var(--paper);z-index:12;transform:translateX(110%);transition:transform .25s;padding:24px;overflow:auto;box-shadow:-10px 0 40px #0001}.cartpanel.open{transform:translateX(0)}.cartline{display:grid;grid-template-columns:72px 1fr auto;gap:12px;border-bottom:1px solid var(--line);padding:15px 0;font-size:12px}.cartline img{width:72px;height:90px;object-fit:cover}.carttotal{display:flex;justify-content:space-between;margin:22px 0;font-weight:bold}.cart-actions{display:flex;gap:8px}.cart-actions button{padding:5px 8px;border:1px solid var(--line);background:transparent}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--ink);color:white;padding:13px 18px;font-size:12px;display:none;z-index:20}.toast.show{display:block}.whatsapp{position:fixed;bottom:20px;right:20px;background:#1f6d48;color:white;padding:13px 16px;border-radius:30px;font-size:12px;box-shadow:0 5px 20px #0002;z-index:5}.about{max-width:760px;margin:auto;text-align:center}.about p{line-height:1.8;color:var(--muted)}.hidden{display:none!important}
@media(max-width:850px){.navlinks{gap:12px}.categories{grid-template-columns:repeat(3,1fr)}.products{grid-template-columns:repeat(2,1fr)}.footergrid{grid-template-columns:1fr 1fr}.hero{min-height:440px}.quick{opacity:1}.category{min-height:180px}}
@media(max-width:600px){.nav{height:65px;padding:0 18px}.navlinks{display:none}.menu{display:block}.hero{width:calc(100% - 20px);margin-top:10px;min-height:460px}.hero-photo{background-position:57% center}.section{padding:50px 18px}.categories{grid-template-columns:repeat(2,1fr)}.category:last-child{grid-column:span 2}.sectionhead{align-items:start;flex-direction:column}.toolbar{width:100%}.toolbar input{flex:1;min-width:100%}.toolbar select{flex:1;min-width:0}.editorial{grid-template-columns:1fr}.editorial-image{min-height:270px}.footergrid{grid-template-columns:1fr 1fr}.footergrid>div:first-child{grid-column:span 2}.footbottom{flex-direction:column}.modalbox{grid-template-columns:1fr}.modalbox img{height:280px;min-height:0}.modalinfo{padding:22px}.whatsapp{bottom:12px;right:12px}.signup{flex-direction:column;gap:8px}.signup button{padding:14px}}
</style></head>
<body>
<div class="announcement">DEMO STORE · SAMPLE PRODUCTS ONLY · CHECKOUT NOT CONNECTED</div>
<header class="nav"><button class="plain menu" onclick="document.querySelector('.navlinks').classList.toggle('mobileopen')">☰</button><a class="logo" href="#">BBM<span>WEAR YOUR VIBE</span></a><nav class="navlinks"><a href="#shop">Shop</a><a href="#categories">Categories</a><a href="#story">Our vibe</a><a href="#contact">Contact</a></nav><div class="navright"><button class="plain" onclick="document.getElementById('search').focus()">⌕ <span class="searchlabel">Search</span></button><button class="plain" onclick="toggleCart(true)">Bag (<span id="cartcount">0</span>)</button></div></header>
<main>
<section class="hero"><div class="hero-photo"></div><div class="hero-copy"><div class="eyebrow">BBM / New-season energy</div><h1>WEAR<br>YOUR VIBE.</h1><p>Everyday essentials with a streetwear state of mind. Find your fit, make it yours.</p><a class="btn light" href="#shop">Explore the collection ↗</a><p style="font-size:10px;opacity:.8;margin-top:18px">DEMO VISUAL · Replace with approved BBM campaign photography</p></div></section>
<section class="section" id="categories"><div class="sectionhead"><div><div class="eyebrow muted">Find your uniform</div><h2>Shop by category</h2></div><span class="note">SAMPLE CATEGORY LINKS</span></div><div class="categories">
<a class="category" href="#shop" onclick="setCategory('T-Shirts')" style="--bg:url('https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=600&q=80')"><strong>T-Shirts<small>Everyday staples ↗</small></strong></a>
<a class="category" href="#shop" onclick="setCategory('Oversized Tees')" style="--bg:url('https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=600&q=80')"><strong>Oversized Tees<small>Room to move ↗</small></strong></a>
<a class="category" href="#shop" onclick="setCategory('Shirts')" style="--bg:url('https://images.unsplash.com/photo-1596755094514-f87e34085b2c?auto=format&fit=crop&w=600&q=80')"><strong>Shirts<small>Layer your look ↗</small></strong></a>
<a class="category" href="#shop" onclick="setCategory('Hoodies')" style="--bg:url('https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=600&q=80')"><strong>Hoodies<small>Off-duty mode ↗</small></strong></a>
<a class="category" href="#shop" onclick="setCategory('Accessories')" style="--bg:url('https://images.unsplash.com/photo-1521369909029-2afed882baee?auto=format&fit=crop&w=600&q=80')"><strong>Accessories<small>Finish the fit ↗</small></strong></a>
</div></section>
<section class="section" id="shop" style="padding-top:10px"><div class="sectionhead"><div><div class="eyebrow muted">Curated for the everyday</div><h2>Featured pieces</h2><p class="note">All products, prices, colors and images below are editable demo content—not live inventory.</p></div><div class="toolbar"><input id="search" type="search" placeholder="Search sample products…" oninput="renderProducts()"><select id="categoryFilter" onchange="renderProducts()"><option value="">All categories</option><option>T-Shirts</option><option>Oversized Tees</option><option>Shirts</option><option>Hoodies</option><option>Accessories</option></select><select id="sort" onchange="renderProducts()"><option value="featured">Featured</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option></select></div></div><div class="products" id="products"></div><p class="note" style="margin-top:24px">Prices are illustrative INR placeholders. Confirm final pricing, GST, shipping, availability, size charts and return terms before launch.</p></section>
<section class="editorial" id="story"><div class="editorial-image" role="img" aria-label="Sample streetwear editorial photography"></div><div class="editorial-copy"><div class="eyebrow">The BBM point of view · Demo copy</div><h2>MAKE IT<br>YOUR OWN.</h2><p class="muted" style="line-height:1.7">Style is personal. BBM is imagined as a home for confident everyday fits, clean essentials and expressive streetwear. This sample story is a placeholder—replace it with the real brand origin and values.</p><a class="btn" style="align-self:start" href="#about">Meet BBM ↗</a></div></section>
<section class="section" id="about"><div class="about"><div class="eyebrow muted">About BBM · Placeholder</div><h2 style="font-size:clamp(34px,5vw,58px);letter-spacing:-.06em">Clothes that feel like you.</h2><p>This is demo About copy, not a verified company statement. Add the founder story, location, sourcing information, manufacturing details and brand commitments only after they are confirmed.</p><a class="btn" href="#contact">Get in touch</a></div></section>
<section class="newsletter"><div class="eyebrow">The BBM edit · Demo form</div><h2>Good fits. No noise.</h2><p class="muted">A sample newsletter signup layout. It will not store or send your email until connected to a real service.</p><form class="signup" onsubmit="event.preventDefault();toast('Demo only: newsletter service is not connected.');"><input type="email" required placeholder="Your email address" aria-label="Your email address"><button type="submit">SIGN ME UP ↗</button></form><div class="note">Connect a consent-aware email platform and add your privacy policy before launch.</div></section>
<section class="section" id="contact"><div class="sectionhead"><div><div class="eyebrow muted">We're listening</div><h2>Contact BBM</h2><p class="muted">Replace these placeholders with verified business contact details.</p></div></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px"><div><b>Email</b><p class="note">[Add official customer-support email]</p></div><div><b>Business address</b><p class="note">[Add address only if you want it public]</p></div><div><b>Social</b><p class="note">[Add official Instagram / social links]</p></div></div></section>
</main>
<footer class="footer"><div class="footergrid"><div><a class="logo" href="#" style="color:#fff">BBM<span>WEAR YOUR VIBE</span></a><p>Premium streetwear energy.<br>Demo storefront — sample content.</p></div><div><h4>Explore</h4><p><a href="#shop">Shop all</a><br><a href="#categories">Categories</a><br><a href="#story">Our vibe</a></p></div><div><h4>Help</h4><p><a href="#contact">Contact</a><br><a href="#contact">Shipping policy [placeholder]</a><br><a href="#contact">Returns [placeholder]</a></p></div><div><h4>Follow BBM</h4><p><a href="#contact">Instagram [add link]</a><br><a href="#contact">WhatsApp [add number]</a></p></div></div><div class="footbottom"><span>© <span id="year"></span> BBM · Demo concept</span><span>Privacy policy · Terms · Shipping — add reviewed pages before launch</span></div></footer>
<a class="whatsapp" href="#" onclick="event.preventDefault();toast('Add BBM’s verified WhatsApp number to activate this button.');">◉ WhatsApp</a>
<div class="modal" id="productModal" onclick="if(event.target===this)closeProduct()"><div class="modalbox"><button class="close" onclick="closeProduct()">✕</button><img id="modalImg" src="" alt="Sample product"><div class="modalinfo"><div class="eyebrow muted">BBM / Sample item</div><h2 id="modalName"></h2><div id="modalPrice" style="font-weight:bold"></div><p class="note">Demo product details. Replace fabric, fit, care, shipping and availability information with verified product data.</p><div class="option"><label for="size">Select size</label><select id="size"><option>S</option><option>M</option><option>L</option><option>XL</option><option>XXL</option></select></div><div class="option"><label for="color">Select color</label><select id="color"><option>Black</option><option>Off-white</option><option>Beige</option><option>Olive</option></select></div><button class="btn" style="width:100%" onclick="addSelected()">Add to demo bag</button><p class="note">Cart works in this browser demo only. Checkout/payment is not integrated.</p></div></div></div>
<aside class="cartpanel" id="cart"><div style="display:flex;justify-content:space-between;align-items:center"><h2>Your bag</h2><button class="plain" onclick="toggleCart(false)">✕ Close</button></div><p class="note">Demo cart — items are not submitted as orders.</p><div id="cartitems"></div><div class="carttotal"><span>Subtotal</span><span id="subtotal">₹0</span></div><p class="note">Shipping and taxes are not calculated. No payment gateway is connected.</p><button class="btn" style="width:100%" onclick="checkout()">Continue to demo checkout ↗</button><button class="plain" style="width:100%;margin-top:10px" onclick="toggleCart(false)">Continue shopping</button></aside>
<div class="toast" id="toast"></div>
<script>
const items=[
{id:1,name:'Essential Logo Tee',cat:'T-Shirts',price:799,color:'Black',img:'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=800&q=85',desc:'Classic everyday tee · sample'},
{id:2,name:'Heavyweight Oversized Tee',cat:'Oversized Tees',price:1199,color:'Off-white',img:'https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=800&q=85',desc:'Relaxed silhouette · sample'},
{id:3,name:'Everyday Oxford Shirt',cat:'Shirts',price:1499,color:'Beige',img:'https://images.unsplash.com/photo-1596755094514-f87e34085b2c?auto=format&fit=crop&w=800&q=85',desc:'Easy layering piece · sample'},
{id:4,name:'Core Pullover Hoodie',cat:'Hoodies',price:1999,color:'Black',img:'https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=800&q=85',desc:'Off-duty layer · sample'},
{id:5,name:'Graphic Statement Tee',cat:'T-Shirts',price:999,color:'Cream',img:'https://images.unsplash.com/photo-1503342217505-b0a15ec3261c?auto=format&fit=crop&w=800&q=85',desc:'Expressive graphic · sample'},
{id:6,name:'Relaxed Fit Shirt',cat:'Shirts',price:1699,color:'Olive',img:'https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=800&q=85',desc:'Laid-back layering · sample'},
{id:7,name:'Everyday Cap',cat:'Accessories',price:599,color:'Black',img:'https://images.unsplash.com/photo-1521369909029-2afed882baee?auto=format&fit=crop&w=800&q=85',desc:'Finish the fit · sample'},
{id:8,name:'Relaxed Oversized Tee',cat:'Oversized Tees',price:1099,color:'Beige',img:'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=800&q=85',desc:'Easy oversized fit · sample'}];
let cart=[],selected=null;
const money=n=>'₹'+n.toLocaleString('en-IN');
function renderProducts(){let q=document.getElementById('search').value.toLowerCase(),c=document.getElementById('categoryFilter').value,s=document.getElementById('sort').value;let list=items.filter(p=>(!c||p.cat===c)&&(p.name+' '+p.cat+' '+p.color).toLowerCase().includes(q));if(s==='low')list.sort((a,b)=>a.price-b.price);if(s==='high')list.sort((a,b)=>b.price-a.price);document.getElementById('products').innerHTML=list.map(p=>`<article class="product"><div class="product-img"><img loading="lazy" src="${p.img}" alt="${p.name} — sample product photo"><span class="sample">Demo item</span><button class="btn quick" onclick="openProduct(${p.id})">Quick view +</button></div><div class="product-meta"><div><div class="product-name">${p.name}</div><div class="product-sub">${p.cat} · ${p.color}</div></div><div class="price">${money(p.price)}</div></div></article>`).join('')||'<p>No sample products match your search.</p>'}
function setCategory(c){document.getElementById('categoryFilter').value=c;renderProducts()}
function openProduct(id){selected=items.find(p=>p.id===id);document.getElementById('modalImg').src=selected.img;document.getElementById('modalName').textContent=selected.name;document.getElementById('modalPrice').textContent=money(selected.price);document.getElementById('productModal').classList.add('open')}
function closeProduct(){document.getElementById('productModal').classList.remove('open')}
function addSelected(){if(!selected)return;cart.push({...selected,size:document.getElementById('size').value,color:document.getElementById('color').value,key:Date.now()+Math.random()});updateCart();closeProduct();toast('Added to your demo bag.')}
function updateCart(){document.getElementById('cartcount').textContent=cart.length;document.getElementById('cartitems').innerHTML=cart.map(p=>`<div class="cartline"><img src="${p.img}" alt=""><div><b>${p.name}</b><p class="note">Size: ${p.size}<br>Color: ${p.color}</p>${money(p.price)}<div class="cart-actions"><button onclick="removeItem(${p.key})">Remove</button></div></div></div>`).join('')||'<p class="note">Your bag is empty.</p>';document.getElementById('subtotal').textContent=money(cart.reduce((a,p)=>a+p.price,0))}
function removeItem(key){cart=cart.filter(p=>p.key!==key);updateCart()}
function toggleCart(open){document.getElementById('cart').classList.toggle('open',open)}
function checkout(){toast('Demo checkout only. No order or payment was submitted.');}
function toast(t){let el=document.getElementById('toast');el.textContent=t;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),2800)}
document.getElementById('year').textContent=new Date().getFullYear();renderProducts();updateCart();
</script></body></html>